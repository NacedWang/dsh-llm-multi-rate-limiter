{
  "name": "@naced/llm-multi-rate-limiter",
  "version": "0.1.1",
  "description": "Per-model LLM call rate limiter for DeepSeek Harness with a Settings section UI, queueing and a live status panel",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "author": "Naced <869521569@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NacedWang/dsh-llm-multi-rate-limiter.git"
  },
  "homepage": "https://github.com/NacedWang/dsh-llm-multi-rate-limiter#readme",
  "bugs": {
    "url": "https://github.com/NacedWang/dsh-llm-multi-rate-limiter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --check lib/index.js && node --check lib/client.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "rate-limiter",
    "llm",
    "token-bucket",
    "sliding-window",
    "cordis-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "package.json",
    "README.zh.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
